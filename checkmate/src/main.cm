import origout.fs as fs
import origout.ed25519 as ed25519
import origout.cli as cli

// The CLI declaration expands to the builder calls before Checkmate checks Run.
grammar commandLine {
    skip [ ' ', '\t', '\r', '\n' ]
    string ( '"' )

    rule app {
        "app" $word name $str about "version" $str version
        "{" each { command } as commands "}"
    }

    rule command {
        "command" $word name $str about
        "{" each { flag } as flags "}"
    }

    rule flag {
        "flag" $word name $str help
    }
}

mega defineCli(commandLine.app as app) {
    int root = cli.NewCommand($"{$app.name}")
    cli.SetAbout(root, $app.about)
    cli.SetVersion(root, $app.version)
    cli.RequireSubcommand(root)

    [each in $app.commands {
        let command = $item
        int $item.name = cli.NewCommand($"{$item.name}")
        cli.SetAbout($item.name, $item.about)
        [each in $item.flags {
            int $item.name = cli.NewArgument($"{$item.name}", "flag", "bool")
            cli.SetLong($item.name, $"{$item.name}")
            cli.SetHelp($item.name, $item.help)
            cli.AddArgument($command.name, $item.name)
        }]
        cli.AddSubcommand(root, $item.name)
    }]
}

KeyPair currentIdentity() {
    str path = fs.GetConfigDir() + "/origout.conf"
    if (fs.PathExists(path)) {
        return ed25519.FromPrivateKey(fs.ReadBytes(path))
    }

    KeyPair pair = ed25519.GenerateKeyPair()
    fs.WriteBytes(path, ed25519.DecodePrivateKey(pair.privateKey))
    return pair
}

impl origout.identity {
    KeyPair GetCurrentIdentity() {
        return currentIdentity()
    }
}

impl origout.app {
    CliRunResult Run(str[] argv) {
        defineCli! {
            app origout "Decentralized, authoritative Git collaboration" version "0.1.0" {
                command identity "Show the current identity" {
                    flag raw "Print only the public key"
                }
            }
        }

        CliParseResult parsed = cli.Parse(root, argv)
        if (parsed.matches == 0) {
            return CliRunResult(exitCode: parsed.exitCode, output: parsed.output)
        }

        if (cli.SubcommandName(parsed.matches) == "identity") {
            int selected = cli.SubcommandMatches(parsed.matches)
            KeyPair pair = currentIdentity()
            option<bool> rawValue = cli.GetBool(selected, "raw")
            match (rawValue) {
                Some(bool show) => {
                    if (show) {
                        return CliRunResult(exitCode: 0, output: pair.publicKey + "\n")
                    }
                }
                None() => {}
            }
            return CliRunResult(exitCode: 0, output: "Current public key: " + pair.publicKey + "\n")
        }

        return CliRunResult(exitCode: 2, output: "Unknown command\n")
    }
}
